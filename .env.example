# Vapi credentials (https://dashboard.vapi.ai). Never commit real values.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# The ONLY phone number the backend is allowed to call.
# Use a number you own or have explicit permission to call.
DEMO_PHONE_NUMBER=

# SQLite database URL
DATABASE_URL=sqlite:///./autopay.db

# Public HTTPS base URL of this backend (REQUIRED for any live Vapi use:
# Vapi posts tool calls and end-of-call reports to {PUBLIC_BASE_URL}/webhooks/vapi,
# e.g. https://your-tunnel.ngrok.io)
PUBLIC_BASE_URL=

# Shared secret for the Vapi webhook. Set this in the Vapi dashboard as the
# secret sent in the X-Webhook-Secret header; the backend rejects requests
# without a matching header (401). If left empty, the webhook accepts
# unauthenticated requests (local development only — do NOT do this in production).
VAPI_WEBHOOK_SECRET=

# Voice for Asha (Vapi). Defaults work; pick an Indian-English/Hindi
# compatible voice in the Vapi dashboard for production demos.
VAPI_VOICE_PROVIDER=11labs
VAPI_VOICE_ID=
